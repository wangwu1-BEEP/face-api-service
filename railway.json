{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "PYTHON",
    "pythonVersion": {
      "version": "3.11"
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "gunicorn --bind 0.0.0.0:$PORT face_api:app --workers 2 --timeout 120"
  }
}
